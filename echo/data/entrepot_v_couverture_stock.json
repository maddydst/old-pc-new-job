{"nom": "v_couverture_stock", "type": "vue", "role": "vue", "schema": "ANALYTICS", "niveau": 3, "aussi": ["cdg", "credit"], "secret": false, "description": "Stock de la dernière semaine et couverture en semaines par produit.", "colonnes": [{"nom": "produit", "type": "VARCHAR"}, {"nom": "libelle", "type": "VARCHAR"}, {"nom": "famille", "type": "VARCHAR"}, {"nom": "stock_fin", "type": "INTEGER"}, {"nom": "seuil_alerte", "type": "INTEGER"}, {"nom": "couverture_semaines", "type": "DOUBLE"}], "lignes": 24, "ouvert": true, "lineage": {"amont": [{"de": "produits", "vers": "v_couverture_stock", "profondeur": 1}, {"de": "stocks", "vers": "v_couverture_stock", "profondeur": 1}], "aval": []}, "sql": "SELECT p.produit, p.libelle, p.famille, s.stock_fin, s.seuil_alerte,\n               round(s.stock_fin / nullif((SELECT avg(sorties) FROM stocks x WHERE x.produit = s.produit), 0), 1) AS couverture_semaines\n        FROM stocks s JOIN produits p USING (produit) WHERE s.semaine = (SELECT max(semaine) FROM stocks)", "apercu": [["AUT-02", "Automate A2", "Automates", "69", "24", "5.8"], ["AUT-04", "Automate A4", "Automates", "60", "22", "5.5"], ["CAP-04", "Capteur C40", "Capteurs", "131", "43", "6.2"], ["VAR-01", "Variateur V2", "Variateurs", "91", "24", "7.5"], ["VAR-02", "Variateur V4", "Variateurs", "72", "22", "6.4"], ["VAR-03", "Variateur V6", "Variateurs", "77", "23", "6.7"], ["LOG-02", "Logiciel L2", "Logiciels", "42", "13", "6.6"], ["LOG-04", "Logiciel L4", "Logiciels", "42", "11", "7.6"], ["SER-01", "Service S1", "Services", "67", "22", "6.1"], ["SER-02", "Service S2", "Services", "89", "24", "7.4"], ["SER-04", "Service S4", "Services", "70", "24", "5.9"], ["PIÈ-01", "Kit pièces P1", "Pièces", "123", "35", "7.0"], ["PIÈ-04", "Kit pièces P4", "Pièces", "134", "39", "6.8"], ["AUT-01", "Automate A1", "Automates", "82", "23", "7.0"], ["AUT-03", "Automate A3", "Automates", "70", "22", "6.4"], ["CAP-01", "Capteur C10", "Capteurs", "141", "43", "6.6"], ["CAP-02", "Capteur C20", "Cap