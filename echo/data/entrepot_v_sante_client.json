{"nom": "v_sante_client", "type": "vue", "role": "vue", "schema": "ANALYTICS", "niveau": 2, "aussi": ["cdg", "credit"], "secret": false, "description": "Vue 360 d'un client : CA récent, tickets, sentiment, retard de paiement.", "colonnes": [{"nom": "compte", "type": "VARCHAR"}, {"nom": "nom", "type": "VARCHAR"}, {"nom": "region", "type": "VARCHAR"}, {"nom": "segment", "type": "VARCHAR"}, {"nom": "commercial", "type": "VARCHAR"}, {"nom": "ca_4_semaines", "type": "DOUBLE"}, {"nom": "tickets_4_semaines", "type": "BIGINT"}, {"nom": "sentiment", "type": "DOUBLE"}, {"nom": "retard_paiement_jours", "type": "DOUBLE"}], "lignes": 120, "ouvert": true, "lineage": {"amont": [{"de": "ventes", "vers": "v_sante_client", "profondeur": 1}, {"de": "comptes", "vers": "v_sante_client", "profondeur": 1}, {"de": "tickets", "vers": "v_sante_client", "profondeur": 1}, {"de": "factures", "vers": "v_sante_client", "profondeur": 1}], "aval": []}, "sql": "SELECT c.compte, c.nom, c.region, c.segment, c.commercial,\n               (SELECT round(sum(montant), 2) FROM ventes v WHERE v.compte = c.compte AND v.date >= DATE '2026-10-19') AS ca_4_semaines,\n               (SELECT count(*) FROM tickets t WHERE t.compte = c.compte AND t.date >= DATE '2026-10-19') AS tickets_4_semaines,\n               (SELECT round(avg(sentiment), 2) FROM tickets t WHERE t.compte = c.compte AND t.date >= DATE '2026-10-19') AS sentiment,\n               (SELECT round(avg(datediff('day', f.echeance, coalesce(f.payee_le, DATE '2026-11-16'))), 1) FROM factures f\n                 WHERE f.compte = c.compte AND f.echeance BETWEEN DATE '2026-08-08' AND DATE '2026-11-16') AS retard_paiement_jours\n        FROM comptes c", "apercu": [["CPT-001", "Borealis Énergie", "Est", "Grand compte", "Léa Martin", "34345.84", "14", "-0.6", "9.3"], ["CPT-002", "Delta Logistique", "Nord", "ETI", "Julien Lefebvre", "9455.78", "0", null, "2.8"], ["CPT-023", "Nova Énergie", "Nord", "PME", "Julien Lefebvre", "5790.44", "0", null, "5.0"], ["CPT-043