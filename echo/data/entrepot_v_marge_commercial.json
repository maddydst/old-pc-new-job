{"nom": "v_marge_commercial", "type": "vue", "role": "vue", "schema": "ANALYTICS", "niveau": 3, "aussi": ["cdg", "credit"], "secret": false, "description": "CA, marge et remise moyenne par commercial et par mois.", "colonnes": [{"nom": "mois", "type": "DATE"}, {"nom": "commercial", "type": "VARCHAR"}, {"nom": "region", "type": "VARCHAR"}, {"nom": "ca", "type": "DOUBLE"}, {"nom": "taux_marge", "type": "DOUBLE"}, {"nom": "remise_moyenne", "type": "DOUBLE"}], "lignes": 108, "ouvert": true, "lineage": {"amont": [{"de": "ventes", "vers": "v_marge_commercial", "profondeur": 1}, {"de": "comptes", "vers": "v_marge_commercial", "profondeur": 1}, {"de": "commerciaux", "vers": "v_marge_commercial", "profondeur": 1}], "aval": [{"de": "v_marge_commercial", "vers": "v_primes_vs_marge", "profondeur": 1}]}, "sql": "SELECT date_trunc('month', v.date)::DATE AS mois, c.commercial, k.region, round(sum(v.montant), 2) AS ca,\n               round(sum(v.marge) / sum(v.montant), 4) AS taux_marge, round(avg(v.remise), 4) AS remise_moyenne\n        FROM ventes v JOIN comptes c USING (compte) JOIN commerciaux k ON k.commercial = c.commercial GROUP BY 1, 2, 3", "apercu": [["2025-06-01", "Léa Martin", "Est", "221133.01", "0.3983", "0.0651"], ["2025-06-01", "Julien Lefebvre", "Nord", "269566.8", "0.3961", "0.0647"], ["2025-06-01", "Thomas Petit", "Ouest", "103618.24", "0.4139", "0.0668"], ["2025-07-01", "Julien Lefebvre", "Nord", "196309.13", "0.4174", "0.0641"], ["2025-07-01", "Camille Roux", "Île-de-France", "184188.51", "0.3988", "0.0684"], ["2025-07-01", "Sarah Garcia", "Sud", "154783.77", "0.3968", "0.066"], ["2025-08-01", "Thomas Petit", "Ouest", "70307.88", "0.4384", "0.0752"], ["2025-08-01", "Paul Bernard", "Île-de-France", "86214.09", "0.3813", "0.0619"], ["2025-09-01", "Léa Martin", "Est", "193265.76", "0.3816", "0.0722"], ["2025-09-01", "Sarah Garcia", "Sud", "44933.47", "0.4358", "0.067"], ["2025-09-01", "Paul Bernard", "Île-de-France", "244385.29", "0.4167", "0.0669"], ["2025-10-01"