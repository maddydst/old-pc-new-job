{"nom": "v_ca_mensuel_region", "type": "vue", "role": "vue", "schema": "ANALYTICS", "niveau": 3, "aussi": ["cdg", "credit"], "secret": false, "description": "CA, marge et objectif par région et par mois.", "colonnes": [{"nom": "mois", "type": "DATE"}, {"nom": "region", "type": "VARCHAR"}, {"nom": "ca", "type": "DOUBLE"}, {"nom": "marge", "type": "DOUBLE"}, {"nom": "objectif", "type": "DOUBLE"}], "lignes": 90, "ouvert": true, "lineage": {"amont": [{"de": "ventes", "vers": "v_ca_mensuel_region", "profondeur": 1}, {"de": "objectifs", "vers": "v_ca_mensuel_region", "profondeur": 1}, {"de": "comptes", "vers": "v_ca_mensuel_region", "profondeur": 1}], "aval": []}, "sql": "WITH r AS (SELECT date_trunc('month', v.date)::DATE AS mois, c.region, sum(v.montant) AS ca, sum(v.marge) AS marge\n                   FROM ventes v JOIN comptes c USING (compte) GROUP BY 1, 2),\n             o AS (SELECT mois, region, sum(objectif_ca) AS objectif FROM objectifs GROUP BY 1, 2)\n        SELECT r.mois, r.region, round(r.ca, 2) AS ca, round(r.marge, 2) AS marge, o.objectif\n        FROM r LEFT JOIN o ON o.mois = r.mois AND o.region = r.region", "apercu": [["2026-01-01", "Nord", "297026.03", "123445.6", "279000.0"], ["2026-02-01", "Nord", "283934.05", "117869.53", "279000.0"], ["2026-03-01", "Nord", "271390.12", "130409.6", "279000.0"], ["2026-05-01", "Nord", "236762.01", "99522.62", "279000.0"], ["2026-06-01", "Nord", "307999.31", "117462.03", "279000.0"], ["2026-08-01", "Nord", "111143.9", "51896.53", "181300.0"], ["2026-09-01", "Nord", "242964.35", "105269.15", "279000.0"], ["2026-10-01", "Nord", "321822.93", "154282.69", "279000.0"], ["2026-04-01", "Est", "256108.69", "111594.89", "230000.0"], ["2026-07-01", "Est", "232777.54", "99710.35", "230000.0"], ["2026-11-01", "Est", "60548.78", "25716.72", "230000.0"], ["2026-04-01", "Ouest", "106080.03", "44907.05", "124200.0"], ["2026-07-01", "Ouest", "109815.65", "49532.97", "124200.0"], ["2026-11-01", "Ouest", "97513.45", "33353.28", "124200.